# Copie para .env e preencha os valores

# App
DEBUG=false
SECRET_KEY=troque-em-producao

# Banco de dados PostgreSQL + PostGIS
DATABASE_URL=postgresql+asyncpg://ceara:ceara@localhost:5432/queimadas

# LLM
# DeepSeek (agentes LangChain — API compatível OpenAI)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Ou sincronize de outro projeto: python scripts/sync_deepseek_env.py

# NASA FIRMS
NASA_FIRMS_API_KEY=sua-chave-firms

# INPE BDQueimadas
INPE_API_KEY=

# FUNCEME
FUNCEME_API_KEY=

# INMET
INMET_TOKEN=

# MapBiomas
MAPBIOMAS_TOKEN=

# Redis
REDIS_URL=redis://localhost:6379/0

# Alertas
ALERTA_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# CORS (frontend)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
